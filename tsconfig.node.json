{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./build/tsc/node",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "test/**/*",
    "scripts/**/*",
    "electron.vite.config.ts",
    "vitest.config.mts"
  ]
}
